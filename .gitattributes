# Normalize line endings to LF in the repo (project deploys to Linux)
* text=auto eol=lf

# Force LF for these file types regardless of OS
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.env.example text eol=lf

# Binary files — no line ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
