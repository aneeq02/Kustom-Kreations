# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/kustom_kreations

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# PayPal
# Set PAYPAL_ENV=sandbox for testing, PAYPAL_ENV=live for production
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID_SANDBOX=
PAYPAL_SECRET_SANDBOX=
PAYPAL_CLIENT_ID_LIVE=
PAYPAL_SECRET_LIVE=
# Set to true to skip PayPal in local dev (no credentials needed)
PAYPAL_DEV_BYPASS=true

# File storage — local folder (dev)
# Leave blank to use the default: backend/uploads/
UPLOADS_DIR=
# The public URL prefix the frontend uses to load images
UPLOADS_BASE_URL=http://localhost:4000/uploads

# Email (SMTP)
# For dev, use Mailtrap (free) or just leave blank to skip emails
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Kustom Kreations <noreply@kustomkreations.co.uk>

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Admin panel PIN
ADMIN_PIN=1234
